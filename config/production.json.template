{
  "environment": "production",
  "debug": false,
  "testing": false,
  "enable_live_trading": false,
  "enable_adaptations": true,
  "enable_ml_predictions": true,
  "enable_regime_detection": true,
  "enable_caching": true,
  "cache_ttl_seconds": 300,
  "enable_parallel_processing": true,
  "max_worker_threads": 4,
  "enable_state_backup": true,
  "backup_interval_hours": 6,
  "backup_retention_days": 30,
  "limits": {
    "max_position_size_usd": 1000.0,
    "max_daily_loss_usd": 500.0,
    "max_portfolio_risk": 0.02,
    "max_drawdown_percent": 5.0,
    "max_adaptation_frequency_hours": 4,
    "min_confidence_threshold": 0.7,
    "max_concurrent_positions": 5,
    "emergency_stop_loss_percent": 10.0
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "database": "adaptive_trading",
    "username": "trading_bot",
    "ssl_mode": "require",
    "connection_pool_size": 10,
    "max_overflow": 20
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "log_dir": "logs/production",
    "max_file_size_mb": 100,
    "backup_count": 10,
    "enable_console": false,
    "enable_file": true,
    "enable_syslog": true,
    "syslog_address": "/dev/log",
    "main_log_file": "adaptive_bot.log",
    "error_log_file": "errors.log",
    "trade_log_file": "trades.log",
    "performance_log_file": "performance.log",
    "adaptation_log_file": "adaptations.log"
  },
  "monitoring": {
    "enable_health_checks": true,
    "health_check_interval_seconds": 60,
    "enable_performance_monitoring": true,
    "performance_check_interval_seconds": 300,
    "enable_email_alerts": true,
    "enable_slack_alerts": false,
    "alert_cooldown_minutes": 30,
    "cpu_usage_threshold": 80.0,
    "memory_usage_threshold": 85.0,
    "disk_usage_threshold": 90.0,
    "api_error_rate_threshold": 5.0
  },
  "security": {
    "enable_api_key_rotation": true,
    "api_key_rotation_days": 30,
    "enable_request_signing": true,
    "enable_ip_whitelist": true,
    "allowed_ips": [],
    "enable_rate_limiting": true,
    "max_requests_per_minute": 100,
    "enable_audit_logging": true
  }
}