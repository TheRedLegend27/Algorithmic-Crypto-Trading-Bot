# Alpaca API credentials
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Set to True for paper trading, False for live trading
IS_PAPER_TRADING=True

# OLD Coinbase Consumer API credentials (DEPRECATED - for reference only)
#.COINBASE_API_KEY=your_coinbase_api_key_here
#.COINBASE_API_SECRET=your_coinbase_api_secret_here

# NEW Coinbase Advanced Trade API credentials (REQUIRED)
# Get these from: https://www.coinbase.com/cloud
# Format: organizations/{org_id}/apiKeys/{key_id}
COINBASE_ADVANCED_API_KEY=
COINBASE_ADVANCED_PRIVATE_KEY=

# Set to True for sandbox trading, False for live trading
# Note: Coinbase no longer provides sandbox environment
COINBASE_SANDBOX=False